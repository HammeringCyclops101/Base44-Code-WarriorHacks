
import React from "react";
import { Trophy, Target, Zap, Star } from "lucide-react";

export default function StatsOverview({ stats, totalChallenges }) {
  const statItems = [
    {
      icon: Trophy,
      label: "Points",
      value: stats.total_points,
      color: "text-yellow-400",
      bg: "bg-yellow-900"
    },
    {
      icon: Target,
      label: "Completed",
      value: stats.challenges_completed,
      color: "text-green-400", 
      bg: "bg-green-900"
    },
    {
      icon: Zap,
      label: "Current Streak",
      value: stats.current_streak,
      color: "text-blue-400",
      bg: "bg-blue-900"
    },
    {
      icon: Star,
      label: "Best Streak",
      value: stats.best_streak,
      color: "text-purple-400",
      bg: "bg-purple-900"
    }
  ];

  return (
    <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      {statItems.map((item, index) => (
        <div key={index} className="bg-gray-800 rounded-xl border border-gray-700 p-4">
          <div className={`w-10 h-10 ${item.bg} rounded-lg flex items-center justify-center mb-3`}>
            <item.icon className={`w-5 h-5 ${item.color}`} />
          </div>
          <p className="text-2xl font-bold text-white mb-1">{item.value}</p>
          <p className="text-sm text-gray-400">{item.label}</p>
        </div>
      ))}
    </div>
  );
}
