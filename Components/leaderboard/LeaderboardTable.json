
import React from "react";
import { Trophy, Medal, Award, Crown } from "lucide-react";

export default function LeaderboardTable({ leaderboard, currentUserEmail }) {
  const getRankIcon = (rank) => {
    switch(rank) {
      case 1: return <Crown className="w-6 h-6 text-yellow-500" />;
      case 2: return <Trophy className="w-6 h-6 text-gray-400" />;
      case 3: return <Medal className="w-6 h-6 text-amber-600" />;
      default: return null;
    }
  };

  const divisionColors = {
    bronze: "bg-amber-900 text-amber-300 border-amber-700",
    silver: "bg-gray-700 text-gray-300 border-gray-600",
    gold: "bg-yellow-900 text-yellow-300 border-yellow-700",
    platinum: "bg-blue-900 text-blue-300 border-blue-700"
  };

  const getRankDisplay = (rank) => {
    if (rank <= 3) {
      return getRankIcon(rank);
    }
    return <span className="font-bold text-gray-600">#{rank}</span>;
  };

  return (
    <div className="bg-gray-800 rounded-2xl border border-gray-700 overflow-hidden">
      <div className="p-6 border-b border-gray-700">
        <h2 className="text-2xl font-bold text-white">Leaderboard</h2>
        <p className="text-gray-400 mt-1">{leaderboard.length} active coders</p>
      </div>

      {leaderboard.length === 0 ? (
        <div className="p-8 text-center">
          <Trophy className="w-16 h-16 text-gray-600 mx-auto mb-4" />
          <p className="text-gray-400 text-lg">No rankings yet</p>
          <p className="text-gray-500">Complete challenges to appear on the leaderboard!</p>
        </div>
      ) : (
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead className="bg-gray-700">
              <tr>
                <th className="px-6 py-4 text-left text-sm font-medium text-gray-300 uppercase tracking-wider">
                  Rank
                </th>
                <th className="px-6 py-4 text-left text-sm font-medium text-gray-300 uppercase tracking-wider">
                  Coder
                </th>
                <th className="px-6 py-4 text-left text-sm font-medium text-gray-300 uppercase tracking-wider">
                  Division
                </th>
                <th className="px-6 py-4 text-left text-sm font-medium text-gray-300 uppercase tracking-wider">
                  Points
                </th>
                <th className="px-6 py-4 text-left text-sm font-medium text-gray-300 uppercase tracking-wider">
                  Completed
                </th>
                <th className="px-6 py-4 text-left text-sm font-medium text-gray-300 uppercase tracking-wider">
                  Streak
                </th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-700">
              {leaderboard.map((user) => (
                <tr
                  key={user.user_email}
                  className={`transition-colors hover:bg-gray-700 ${
                    user.user_email === currentUserEmail 
                      ? "bg-blue-900 hover:bg-blue-800 border-l-4 border-blue-500" 
                      : ""
                  }`}
                >
                  <td className="px-6 py-4">
                    <div className="flex items-center justify-center w-8">
                      {getRankDisplay(user.rank)}
                    </div>
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full flex items-center justify-center">
                        <span className="text-white font-semibold text-sm">
                          {user.full_name?.charAt(0)?.toUpperCase() || '?'}
                        </span>
                      </div>
                      <div>
                        <p className="font-medium text-white">
                          {user.full_name || 'Anonymous'}
                          {user.user_email === currentUserEmail && (
                            <span className="ml-2 text-blue-400 text-sm font-normal">(You)</span>
                          )}
                        </p>
                        <p className="text-sm text-gray-400">{user.favorite_language || 'Python'}</p>
                      </div>
                    </div>
                  </td>
                  <td className="px-6 py-4">
                    <span className={`px-3 py-1 rounded-full text-sm font-medium border ${divisionColors[user.division]}`}>
                      {user.division.charAt(0).toUpperCase() + user.division.slice(1)}
                    </span>
                  </td>
                  <td className="px-6 py-4">
                    <span className="text-lg font-bold text-white">{user.total_points}</span>
                  </td>
                  <td className="px-6 py-4">
                    <span className="text-gray-300">{user.challenges_completed}</span>
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex items-center gap-1">
                      <span className="text-gray-300">{user.current_streak}</span>
                      {user.current_streak > 0 && (
                        <span className="text-orange-400">🔥</span>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}
