
import React from "react";
import { format } from "date-fns";
import { CheckCircle, Clock, Code } from "lucide-react";

export default function RecentActivity({ progress, paths }) {
  const recentProgress = progress.slice(0, 5);

  const getPathTitle = (pathId) => {
    const path = paths.find(p => p.id === pathId);
    return path?.title || "Unknown Path";
  };

  return (
    <div className="bg-gray-800 rounded-2xl border border-gray-700 p-6">
      <h3 className="text-xl font-bold text-white mb-6">Recent Activity</h3>
      
      {recentProgress.length === 0 ? (
        <div className="text-center py-8">
          <Code className="w-12 h-12 text-gray-600 mx-auto mb-4" />
          <p className="text-gray-400">No activity yet. Start your first challenge!</p>
        </div>
      ) : (
        <div className="space-y-4">
          {recentProgress.map((item, index) => (
            <div key={index} className="flex items-center gap-4 p-3 rounded-lg hover:bg-gray-700 transition-colors">
              <div className={`w-8 h-8 rounded-full flex items-center justify-center ${
                item.completed ? 'bg-green-900' : 'bg-gray-700'
              }`}>
                {item.completed ? (
                  <CheckCircle className="w-4 h-4 text-green-400" />
                ) : (
                  <Clock className="w-4 h-4 text-gray-500" />
                )}
              </div>
              
              <div className="flex-1">
                <p className="font-medium text-white">
                  {item.completed ? 'Completed' : 'Attempted'} challenge
                </p>
                <p className="text-sm text-gray-400">
                  {getPathTitle(item.path_id)} • {format(new Date(item.updated_date), 'MMM d, h:mm a')}
                </p>
              </div>
              
              {item.points_earned > 0 && (
                <div className="text-right">
                  <p className="font-bold text-blue-400">+{item.points_earned}</p>
                  <p className="text-xs text-gray-500">points</p>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
