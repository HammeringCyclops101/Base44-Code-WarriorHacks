{
  "name": "UserStats",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Total points earned"
    },
    "division": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze",
      "description": "User's current division"
    },
    "challenges_completed": {
      "type": "number",
      "default": 0,
      "description": "Total challenges completed"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Current daily completion streak"
    },
    "best_streak": {
      "type": "number",
      "default": 0,
      "description": "Best ever streak"
    },
    "favorite_language": {
      "type": "string",
      "description": "Most used programming language"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last time user was active"
    }
  },
  "required": [
    "user_email"
  ]
}
